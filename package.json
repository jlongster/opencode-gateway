{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-gateway": "./src/cli.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "format:check": "prettier --check .",
    "lint": "oxlint src script test",
    "start": "bun run src/cli.ts",
    "test": "bun test --only-failures",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "@effect/sql-sqlite-bun": "4.0.0-beta.101",
    "@opencode-ai/client": "0.0.0-next-17444",
    "@opencode-ai/protocol": "0.0.0-next-17444",
    "@opencode-ai/schema": "0.0.0-next-17444",
    "effect": "4.0.0-beta.101",
    "modal": "0.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "0.0.0-next-17444",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "oxlint": "1.60.0",
    "prettier": "3.6.2",
    "solid-js": "1.9.10",
    "typescript": "5.8.2"
  }
}
